[Service]
# Bind Ollama to loopback and disable its cloud features. Install/pin reviewed
# models before applying this sealed production override.
Environment="OLLAMA_HOST=127.0.0.1:11434"
Environment="OLLAMA_NO_CLOUD=1"

# Defense in depth for normal inference. Confirm enforcement and a negative
# egress test on the target host; service-manager policy is deployment evidence,
# not something OpenProjects can verify for you.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=127.0.0.0/8
IPAddressAllow=::1/128
