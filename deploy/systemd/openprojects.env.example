NODE_ENV=production
OPENPROJECTS_DATABASE=/var/lib/openprojects/openprojects.db
OPENPROJECTS_HOST=127.0.0.1
OPENPROJECTS_PORT=4310

# Do not set OPENPROJECTS_MODEL_* in the sealed profile: those variables
# override the reviewed YAML's base-model declaration. Telegram credentials are
# intentionally absent. The sealed YAML uses an owner-only Unix control socket;
# these host/port compatibility values are ignored while socketPath is set.

# OLLAMA_NO_CLOUD=1 belongs in the separately managed Ollama service environment,
# not here; this unit does not launch or constrain Ollama.
