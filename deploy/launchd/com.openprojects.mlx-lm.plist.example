<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.openprojects.mlx-lm</string>

  <key>UserName</key>
  <string>_openprojects</string>
  <key>GroupName</key>
  <string>_openprojects</string>
  <key>WorkingDirectory</key>
  <string>/Library/OpenProjects</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Library/OpenProjects/mlx-venv/bin/python3</string>
    <string>-I</string>
    <string>-m</string>
    <string>mlx_lm</string>
    <string>server</string>
    <string>--model</string>
    <string>/Library/OpenProjects/models/Qwen3-1.7B-4bit</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>8080</string>
    <string>--decode-concurrency</string>
    <string>1</string>
    <string>--prompt-concurrency</string>
    <string>1</string>
    <string>--prompt-cache-size</string>
    <string>1</string>
    <string>--prompt-cache-bytes</string>
    <string>268435456</string>
    <string>--allowed-origins</string>
    <string>http://127.0.0.1</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HF_HUB_OFFLINE</key>
    <string>1</string>
    <key>TRANSFORMERS_OFFLINE</key>
    <string>1</string>
    <key>HF_HUB_DISABLE_TELEMETRY</key>
    <string>1</string>
    <key>PYTHONNOUSERSITE</key>
    <string>1</string>
    <key>HF_HOME</key>
    <string>/Library/Application Support/OpenProjects/cache/huggingface</string>
    <key>HF_HUB_CACHE</key>
    <string>/Library/Application Support/OpenProjects/cache/huggingface/hub</string>
    <key>TMPDIR</key>
    <string>/Library/Application Support/OpenProjects/tmp</string>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>Umask</key>
  <integer>63</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>/Library/Logs/OpenProjects/mlx-lm.log</string>
  <key>StandardErrorPath</key>
  <string>/Library/Logs/OpenProjects/mlx-lm.error.log</string>
</dict>
</plist>
