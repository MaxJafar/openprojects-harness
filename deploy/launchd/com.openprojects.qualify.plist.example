<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.openprojects.qualify</string>

  <key>UserName</key>
  <string>_openprojects</string>
  <key>GroupName</key>
  <string>_openprojects</string>
  <key>WorkingDirectory</key>
  <string>/Library/OpenProjects/app</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Library/OpenProjects/runtime/bin/node</string>
    <string>/Library/OpenProjects/app/dist/src/cli.js</string>
    <string>qualify</string>
    <string>--config</string>
    <string>/Library/OpenProjects/etc/openprojects.local.yaml</string>
    <string>--manifest</string>
    <string>/Library/OpenProjects/etc/appliance-qualification.json</string>
    <string>--json</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_ENV</key>
    <string>production</string>
    <key>TMPDIR</key>
    <string>/Library/Application Support/OpenProjects/tmp</string>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>Umask</key>
  <integer>63</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Library/Logs/OpenProjects/qualification.json</string>
  <key>StandardErrorPath</key>
  <string>/Library/Logs/OpenProjects/qualification.error.log</string>
</dict>
</plist>
