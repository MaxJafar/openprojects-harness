# The YAML model declaration is used when these variables are unset. The
# recommended private profile needs no model API key. Do not set empty override
# values: either leave these lines commented or provide a complete reviewed
# local override.
# OPENPROJECTS_MODEL_PROVIDER=ollama
# OPENPROJECTS_MODEL=qwen3.5:9b
# OPENPROJECTS_MODEL_BASE_URL=http://127.0.0.1:11434/v1
# OPENPROJECTS_MODEL_API_KEY is intentionally absent.

# Optional hosted-route credentials. A key alone enables nothing: the YAML must
# name it through apiKeyEnv, opt in with routing.externalInference: allow, and
# allowlist the exact HTTPS origin when privacy.localOnly is true. Keep these
# commented when unused; never copy a key into YAML or commit it.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional separate credential for an OpenAI-compatible embedding endpoint.
# Cloud embedding also requires embeddings.externalData: allow and discloses
# retrieval queries plus any memory text sent during an explicit backfill.
# OPENPROJECTS_EMBEDDING_API_KEY=

OPENPROJECTS_DATABASE=./data/openprojects.db
OPENPROJECTS_HOST=127.0.0.1
OPENPROJECTS_PORT=4310
# Development escape hatch only; this is not authentication.
# OPENPROJECTS_ALLOW_PUBLIC_UNAUTHENTICATED=false

# Optional Telegram webhook adapter. Credentials have no effect until the YAML
# explicitly sets telegram.enabled: true and allowlists the API origin.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Required, fail-closed operator IDs for DMs and group administration.
TELEGRAM_ALLOWED_USER_IDS=
# Avoids a getMe lookup when validating /command@bot_username messages.
TELEGRAM_BOT_USERNAME=

# Read-only Corporate Oracle sidecars. The YAML contains only these variable
# names; inject values through the host secret manager. OAuth login, refresh,
# and rotation are not performed by the v1 sidecar.
# OP_LINEAR_SIDECAR_TOKEN=
# OP_JIRA_SIDECAR_TOKEN=
